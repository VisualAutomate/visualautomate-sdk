{
  "description": "Put an emoji reaction on a message",
  "icon": "smile",
  "color": "#4a154b",
  "timeoutMs": 30000,
  "version": 1,
  "auth": {
    "type": "none"
  },
  "properties": {
    "token": {
      "label": "Slack bot token",
      "type": "secret",
      "required": true,
      "group": "Account",
      "description": "The xoxb- token of your Slack app, installed in the workspace"
    },
    "channel": {
      "label": "Channel id",
      "type": "string",
      "required": true,
      "group": "Message"
    },
    "timestamp": {
      "label": "Message timestamp",
      "type": "string",
      "required": true,
      "group": "Message"
    },
    "name": {
      "label": "Emoji",
      "type": "string",
      "required": true,
      "description": "The name without colons, e.g. thumbsup",
      "group": "Message"
    }
  },
  "inputs": [
    "input"
  ],
  "outputs": [
    "success",
    "error"
  ],
  "outputFields": {
    "added": {
      "type": "true/false",
      "description": "Whether Slack accepted it"
    },
    "name": {
      "type": "text",
      "description": "The emoji used"
    },
    "timestamp": {
      "type": "text",
      "description": "The message it went on"
    }
  },
  "action": {
    "baseUrl": "https://slack.com/api",
    "request": {
      "method": "POST",
      "path": "reactions.add",
      "body": {
        "channel": "{{config.channel}}",
        "timestamp": "{{config.timestamp}}",
        "name": "{{config.name}}"
      },
      "headers": {
        "Authorization": "Bearer {{config.token}}"
      }
    },
    "okPath": "ok",
    "errorPath": "error",
    "outputs": {
      "added": true,
      "name": "{{config.name}}",
      "timestamp": "{{config.timestamp}}"
    }
  }
}
