{
  "description": "Look up a member of the workspace by their address",
  "icon": "search",
  "color": "#4a154b",
  "timeoutMs": 30000,
  "version": 1,
  "auth": {
    "type": "none"
  },
  "properties": {
    "token": {
      "label": "Slack bot token",
      "type": "secret",
      "required": true,
      "group": "Account",
      "description": "The xoxb- token of your Slack app, installed in the workspace"
    },
    "email": {
      "label": "Email",
      "type": "string",
      "required": true,
      "group": "Search"
    }
  },
  "inputs": [
    "input"
  ],
  "outputs": [
    "success",
    "error"
  ],
  "outputFields": {
    "id": {
      "type": "text",
      "description": "Their user id, which every other method wants"
    },
    "name": {
      "type": "text",
      "description": "Their display name"
    },
    "email": {
      "type": "text",
      "description": "The address that was looked up"
    }
  },
  "action": {
    "baseUrl": "https://slack.com/api",
    "request": {
      "method": "GET",
      "path": "users.lookupByEmail",
      "query": {
        "email": "{{config.email}}"
      },
      "headers": {
        "Authorization": "Bearer {{config.token}}"
      }
    },
    "okPath": "ok",
    "errorPath": "error",
    "outputs": {
      "id": "{{response.user.id}}",
      "name": "{{response.user.real_name}}",
      "email": "{{config.email}}"
    }
  }
}
