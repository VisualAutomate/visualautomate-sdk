{
  "description": "Read one message: its headers, its snippet and its parts",
  "icon": "mail-open",
  "color": "#ea4335",
  "timeoutMs": 30000,
  "version": 1,
  "auth": {
    "type": "oauth2",
    "provider": "google-mail",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.modify"
    ]
  },
  "properties": {
    "account": {
      "label": "Google account",
      "type": "connection",
      "provider": "google-mail",
      "required": true,
      "description": "Which Gmail account this step acts as",
      "group": "Account"
    },
    "messageId": {
      "label": "Message id",
      "type": "string",
      "required": true,
      "group": "Message"
    },
    "format": {
      "label": "How much",
      "type": "select",
      "default": "full",
      "options": [
        {
          "label": "Everything",
          "value": "full"
        },
        {
          "label": "Headers and snippet only",
          "value": "metadata"
        },
        {
          "label": "The raw message",
          "value": "raw"
        }
      ],
      "group": "Message"
    }
  },
  "inputs": [
    "input"
  ],
  "outputs": [
    "success",
    "error"
  ],
  "outputFields": {
    "id": {
      "type": "text",
      "description": "The message's id"
    },
    "threadId": {
      "type": "text",
      "description": "The conversation it belongs to"
    },
    "snippet": {
      "type": "text",
      "description": "The first line or so, as Gmail shows it"
    },
    "headers": {
      "type": "list",
      "description": "From, To, Subject and the rest, as a list of name and value"
    },
    "labelIds": {
      "type": "list",
      "description": "The labels on it"
    },
    "payload": {
      "type": "list",
      "description": "The body parts, base64url encoded as Gmail stores them"
    }
  },
  "action": {
    "connection": "account",
    "request": {
      "method": "GET",
      "path": "gmail/v1/users/me/messages/{{config.messageId}}",
      "query": {
        "format": "{{config.format}}"
      }
    },
    "errorPath": "error.message",
    "outputs": {
      "id": "{{response.id}}",
      "threadId": "{{response.threadId}}",
      "snippet": "{{response.snippet}}",
      "headers": "{{response.payload.headers}}",
      "labelIds": "{{response.labelIds}}",
      "payload": "{{response.payload}}"
    }
  }
}
