{
  "description": "Label a message, archive it, or mark it read",
  "icon": "tag",
  "color": "#ea4335",
  "timeoutMs": 30000,
  "version": 1,
  "auth": {
    "type": "oauth2",
    "provider": "google-mail",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.modify"
    ]
  },
  "properties": {
    "account": {
      "label": "Google account",
      "type": "connection",
      "provider": "google-mail",
      "required": true,
      "description": "Which Gmail account this step acts as",
      "group": "Account"
    },
    "messageId": {
      "label": "Message id",
      "type": "string",
      "required": true,
      "group": "Message"
    },
    "addLabelIds": {
      "label": "Add labels",
      "type": "string",
      "description": "Label ids, separated by commas",
      "group": "Labels"
    },
    "removeLabelIds": {
      "label": "Remove labels",
      "type": "string",
      "description": "Ids. UNREAD marks it read, INBOX archives it.",
      "group": "Labels"
    }
  },
  "inputs": [
    "input"
  ],
  "outputs": [
    "success",
    "error"
  ],
  "outputFields": {
    "id": {
      "type": "text",
      "description": "The message that changed"
    },
    "labelIds": {
      "type": "list",
      "description": "The labels on it afterwards"
    }
  },
  "action": {
    "connection": "account",
    "request": {
      "method": "POST",
      "path": "gmail/v1/users/me/messages/{{config.messageId}}/modify",
      "body": {
        "addLabelIds": "{{config.addLabelIds | list}}",
        "removeLabelIds": "{{config.removeLabelIds | list}}"
      }
    },
    "errorPath": "error.message",
    "outputs": {
      "id": "{{response.id}}",
      "labelIds": "{{response.labelIds}}"
    }
  }
}
