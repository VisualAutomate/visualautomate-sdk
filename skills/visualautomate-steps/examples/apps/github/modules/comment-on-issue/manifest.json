{
  "description": "Add a comment to an issue or a pull request",
  "icon": "message-square",
  "color": "#24292f",
  "timeoutMs": 30000,
  "version": 1,
  "auth": {
    "type": "none"
  },
  "properties": {
    "token": {
      "label": "GitHub token",
      "type": "secret",
      "required": true,
      "group": "Account",
      "description": "A fine-grained personal access token with access to the repository"
    },
    "owner": {
      "label": "Owner",
      "type": "string",
      "required": true,
      "group": "Repository"
    },
    "repo": {
      "label": "Repository",
      "type": "string",
      "required": true,
      "group": "Repository"
    },
    "issue_number": {
      "label": "Issue or pull request number",
      "type": "number",
      "required": true,
      "group": "Comment"
    },
    "body": {
      "label": "Comment",
      "type": "string",
      "required": true,
      "description": "Markdown is understood",
      "group": "Comment"
    }
  },
  "inputs": [
    "input"
  ],
  "outputs": [
    "success",
    "error"
  ],
  "outputFields": {
    "id": {
      "type": "text",
      "description": "The comment's id"
    },
    "url": {
      "type": "text",
      "description": "A link to it"
    },
    "body": {
      "type": "object",
      "description": "What was written"
    }
  },
  "action": {
    "baseUrl": "https://api.github.com",
    "request": {
      "method": "POST",
      "path": "repos/{{config.owner}}/{{config.repo}}/issues/{{config.issue_number}}/comments",
      "body": {
        "body": "{{config.body}}"
      },
      "headers": {
        "Authorization": "Bearer {{config.token}}",
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28"
      }
    },
    "errorPath": "message",
    "outputs": {
      "id": "{{response.id}}",
      "url": "{{response.html_url}}",
      "body": "{{config.body}}"
    }
  }
}
