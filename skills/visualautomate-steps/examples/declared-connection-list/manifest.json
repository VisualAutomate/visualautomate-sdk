{
  "description": "Lists the repositories of a connected GitHub account",
  "icon": "github",
  "auth": {
    "type": "oauth2",
    "provider": "github"
  },
  "properties": {
    "account": {
      "label": "GitHub account",
      "type": "connection",
      "provider": "github",
      "required": true
    },
    "sort": {
      "label": "Sort by",
      "type": "select",
      "default": "pushed",
      "options": [
        {
          "label": "Last pushed",
          "value": "pushed"
        },
        {
          "label": "Name",
          "value": "full_name"
        }
      ]
    },
    "limit": {
      "label": "At most",
      "type": "number",
      "default": 50,
      "min": 1,
      "max": 300
    }
  },
  "inputs": [
    "input"
  ],
  "outputs": [
    "success",
    "error"
  ],
  "outputFields": {
    "items": {
      "type": "list",
      "description": "One entry per repository: name, url, private"
    },
    "count": {
      "type": "number",
      "description": "How many came back"
    }
  },
  "action": {
    "connection": "account",
    "request": {
      "method": "GET",
      "path": "user/repos",
      "query": {
        "sort": "{{config.sort}}",
        "per_page": "100",
        "page": "{{cursor}}"
      }
    },
    "items": {
      "path": "",
      "limit": 300
    },
    "paginate": {
      "from": "page",
      "start": 1,
      "maxPages": 3
    },
    "errorPath": "message",
    "outputs": {
      "name": "{{item.full_name}}",
      "url": "{{item.html_url}}",
      "private": "{{item.private}}"
    }
  }
}
