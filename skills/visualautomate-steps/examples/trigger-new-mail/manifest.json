{
  "description": "Starts a run for each new email",
  "icon": "mail",
  "auth": {
    "type": "oauth2",
    "provider": "outlook",
    "scopes": [
      "Mail.Read"
    ]
  },
  "properties": {
    "account": {
      "label": "Mailbox",
      "type": "connection",
      "provider": "outlook",
      "required": true
    },
    "poll_minutes": {
      "label": "Check every (minutes)",
      "type": "number",
      "default": 5,
      "min": 1
    }
  },
  "inputs": [],
  "outputs": [
    "success"
  ],
  "outputFields": {
    "subject": "The email's subject",
    "from": "Who sent it"
  },
  "trigger": {
    "connection": "account",
    "poll": "poll_minutes",
    "request": {
      "path": "/v1.0/me/mailFolders/inbox/messages/delta"
    },
    "items": "value",
    "id": "id",
    "cursor": {
      "from": "response",
      "path": "@odata.deltaLink",
      "as": "url",
      "initial": "now"
    },
    "maxPerPoll": 10
  }
}
